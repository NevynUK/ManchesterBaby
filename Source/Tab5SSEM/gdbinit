# gdbinit -- command-line GDB session against OpenOCD started by ./debug.sh.
#
#   riscv32-esp-elf-gdb -x gdbinit build/Tab5SSEM.elf
#
# debug.cfg turns every breakpoint into a hardware one, and the ESP32-P4 has
# only a few triggers per core, so keep the number of breakpoints small.

set pagination off
target extended-remote localhost:3333
monitor reset halt
maintenance flush register-cache
thbreak app_main
continue
