# scripts/clion/tools.local.env.example -- per-machine tool overrides.
#
# Copy to scripts/clion/tools.local.env (not committed) and uncomment what you
# need.  The scripts in scripts/clion source it before resolving any tool, so
# it suits settings you do not want in your login shell.  Environment variables
# set elsewhere are overridden by anything assigned here.

# ESP-IDF to use (default 6.1); or name the activation script directly.
# IDF_VERSION=6.1
# IDF_ACTIVATE="$HOME/.espressif/tools/activate_idf_v6.1.sh"

# Pin a specific OpenOCD or GDB instead of the ones the IDF provides.
# OPENOCD="$HOME/.espressif/tools/openocd-esp32/v0.12.0-esp32-20260703/openocd-esp32/bin/openocd"
# IDF_GDB="$HOME/.espressif/tools/riscv32-esp-elf-gdb/17.1_20260402/riscv32-esp-elf-gdb/bin/riscv32-esp-elf-gdb"
